    "dev:frontend": "vite",
    "build": "vite build",
    "check:ticket-parity": "esbuild scripts/check-ticket-parity.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/ticket-parity.cjs --log-level=error && node node_modules/.cache/ticket-parity.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
